# Exclude version control and tool metadata
.git/
.gitignore
.gcloudignore
.dockerignore
.github/
.agents/
.aistudio/
.vscode/
.idea/

# Exclude local dependencies (installed during image build)
node_modules/

# Exclude cached ML model files and local caches (165 MB+)
.cache/

# Exclude historical test/verification reports, archives, and documentation (33 MB+)
docs/
README.md
AGENTS.md

# Exclude build output and test coverage/results
dist/
coverage/
.vitest/
test-results/
playwright-report/
blob-report/

# Exclude test suites, unit tests, and offline verification scripts
e2e/
e2e-real-sdk/
scripts/mirage/
scripts/testing/
scripts/real-sdk/
public/assets/aistudio/
pyproject.toml
requirements-mirage.txt
playwright.config.ts
playwright.real-sdk.config.ts
vitest.config.ts
vite.real-sdk.config.ts
eslint.config.js
**/*.test.ts
**/*.test.tsx
**/*.spec.ts

# Exclude binary cache/model files and archives
*.onnx
*.onnx.gz
*.cact
*.tflite
*.zip
*.tar.gz

# Logs and system files
*.log
.DS_Store
Thumbs.db
bun.lock
bun.lockb
