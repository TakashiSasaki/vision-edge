# Exclude version control and tool metadata
.git/
.gitignore
.gcloudignore
.dockerignore
.github/
.agents/
.vscode/
.idea/

# Exclude local dependencies (installed during image build)
node_modules/

# Exclude cached ML model files and local caches (165 MB+)
.cache/

# Exclude historical test/verification reports, archives, and documentation (33 MB+)
docs/

# Exclude build output and test coverage/results
dist/
coverage/
.vitest/
test-results/
playwright-report/
blob-report/

# Exclude test suites and offline verification scripts
e2e/
e2e-real-sdk/
scripts/mirage/
scripts/testing/
scripts/real-sdk/
pyproject.toml
requirements-mirage.txt

# Exclude binary cache/model files and archives
*.onnx
*.onnx.gz
*.cact
*.tflite
*.zip
*.tar.gz

# Logs and system files
*.log
.DS_Store
Thumbs.db
bun.lock
bun.lockb

